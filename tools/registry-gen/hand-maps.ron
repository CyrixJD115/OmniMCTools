// Hand-authored semantic mappings for tools/registry-gen.
//
// Value semantics worked out against the MIT-licensed HiveGamesOSS/Chunker
// reference (BedrockStateGroups/BedrockStateTypes tables) and palette probes
// of the 1.26.52 fixture worlds; family membership follows the pinned Java
// 26.3 registry. Bedrock-side block-entity-carried info (banner/bed colors,
// flower-pot plants, note pitch, shulker facing) is intentionally out of
// scope here — that is M4 tile-mapping work, not block-table work.

(
    patterns: {
        "amethyst_bud": (
            props: {
                "facing": {
                    "down": state("minecraft:block_face", "down"),
                    "east": state("minecraft:block_face", "east"),
                    "north": state("minecraft:block_face", "north"),
                    "south": state("minecraft:block_face", "south"),
                    "up": state("minecraft:block_face", "up"),
                    "west": state("minecraft:block_face", "west"),
                },
            },
            drop: ["waterlogged"],
        ),
        "anvil": (
            props: {
